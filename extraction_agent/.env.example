# ────────────────────────────────
# REQUIRED
# ────────────────────────────────
# Your OpenRouter (or any supported provider) API key
OPENROUTER_API_KEY=or_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ────────────────────────────────
# OPTIONAL – OVERRIDES
# ────────────────────────────────
# Change model (default: x-ai/grok-code-fast-1 – fast & cheap)
# OPENAI_MODEL_NAME=x-ai/grok-code-fast-1
# OPENAI_MODEL_NAME=anthropic/claude-3-5-sonnet-20241022
# OPENAI_MODEL_NAME=openai/gpt-4o-mini

# ────────────────────────────────
# SECURITY – n8n-only rotating API key
# ────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EXTRACTION_AGENT_API_KEY=your_very_long_random_key_9k8j3h2j4b5n6m7v8c9x0z1a2s3d4f5g

# Leave empty or remove line to disable API-key check entirely (local dev only)
# EXTRACTION_AGENT_API_KEY=

# ────────────────────────────────
# FUTURE-PROOF (currently unused but safe to keep)
# ────────────────────────────────
# Redis for session persistence across restarts (optional, in-memory is fine for most cases)
# REDIS_URL=redis://default:password@host:6379/0

# Session TTL in seconds (default 48 hours if you ever enable Redis)
# SESSION_TTL_SECONDS=172800