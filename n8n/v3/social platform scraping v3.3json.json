        "operation": "executeQuery",
        "query": "INSERT INTO public.data_transit (user_id, run_id, entity_id, attribute, value, created_at)\nSELECT\n    (item->>'user_id')::int,    -- Cast to Integer for ForeignKey\n    (item->>'run_id')::int,     -- Cast to Integer for ForeignKey\n    item->>'entity_id',\n    item->>'attribute',\n    item->>'value',\n    NOW()                       -- Database generates the timestamp\nFROM jsonb_array_elements($1::jsonb) AS item;",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json.eav_rows) }}"
        }
